---
import { getCollection } from 'astro:content';
import { withBase } from '../lib/paths';
const entries = (await getCollection('notes', ({ data }) =>
  !data.draft && !data.demo && data.category === 'teaching'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<section class="teaching-lectures" id="teaching-lectures" aria-labelledby="teaching-lectures-heading">
  <div class="teaching-heading">
    <div>
      <h2 id="teaching-lectures-heading">教学讲义</h2>
      <p>高级人工智能与高级算法设计与分析，按授课专题阅读、演算与复习。</p>
    </div>
    <a class="text-link" href={withBase('/notes/#notes-group-teaching-lectures')}>查看教学讲义目录 →</a>
  </div>
  <ul class="teaching-list">
    {entries.map(entry => <li>
      <h3><a href={withBase(entry.data.html || '/notes/' + entry.id + '/')}>{entry.data.title.split(' · ')[0]} <span aria-hidden="true">↗</span></a></h3>
      <p>{entry.data.description}</p>
      <div class="teaching-details">
        <span>{entry.data.chapters} 个专题</span>
        <time datetime={entry.data.date.toISOString().slice(0, 10)}>更新于 {entry.data.date.toISOString().slice(0, 10)}</time>
        <a href={withBase('/notes/' + entry.id + '/')}>范围与阅读说明 →</a>
      </div>
    </li>)}
  </ul>
</section>
<style>
  .teaching-lectures{padding:32px;background:var(--mint);margin:32px 0 48px}
  .teaching-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:24px}
  .teaching-heading h2{font-family:var(--sans);font-size:28px;font-weight:550;line-height:1.4;margin:0 0 12px}
  .teaching-heading p{font-size:16px;line-height:1.85;color:var(--ink);max-width:44em}
  .teaching-heading>.text-link{min-height:44px;font-size:14px;flex-shrink:0}
  .teaching-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:36px;list-style:none;padding:0;margin:30px 0 0}
  .teaching-list li{min-width:0}
  .teaching-list h3{font-family:var(--sans);font-size:22px;font-weight:550;line-height:1.6;margin:0 0 12px}
  .teaching-list h3 a{color:var(--green-dark);text-decoration:underline;text-underline-offset:5px}
  .teaching-list h3 a:hover{color:var(--ink)}
  .teaching-list p{font-size:16px;line-height:1.85;color:var(--ink);margin:0 0 18px}
  .teaching-details{display:flex;flex-wrap:wrap;gap:10px 20px;font-size:14px;line-height:1.8;color:var(--muted)}
  .teaching-details a{color:var(--green-dark);text-decoration:underline;text-underline-offset:3px}
  @media(max-width:850px){.teaching-heading{display:block}.teaching-heading>.text-link{margin-top:10px}.teaching-list{grid-template-columns:1fr;gap:28px}}
  @media(max-width:480px){.teaching-lectures{padding:24px 20px}.teaching-heading h2{font-size:24px}.teaching-list h3{font-size:20px}}
</style>
