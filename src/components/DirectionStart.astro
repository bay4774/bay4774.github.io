---
import curriculum from '../data/direction-curriculum.json';
import { getCollection } from 'astro:content';
import { directionChapters } from '../lib/directions';
import { withBase } from '../lib/paths';
const entries = await getCollection('notes');
---
<section class="direction-start" aria-label="六方向基础讲义入口">
  <div class="direction-heading"><div><h2>沿你的问题，进入六个方向。</h2></div><a class="text-link" href={withBase('/notes/direction-foundations/')}>章节目录与学习路径 →</a></div>
  <p>已掌握公共基础后，选择一个主方向。按概念和先修关系拆章，配推导、算例、自测和步骤答案；交叉主题按需借读。</p>
  <div class="direction-grid">{curriculum.tracks.map(track => <a href={withBase('/notes/direction-foundations/#' + track.id)}><span>{track.prefix} / {directionChapters(entries, track.id).length} 章</span><h3>{track.title}</h3><p>{track.subtitle}</p></a>)}</div>
</section>
<style>
  .direction-start{padding:28px;background:var(--mint);margin:0 0 32px}
  .direction-heading{display:flex;gap:20px;align-items:center;justify-content:space-between;flex-wrap:wrap}
  .direction-heading h2{font-family:var(--sans);font-size:25px;font-weight:500;line-height:1.5;letter-spacing:-.4px;margin:0 0 12px}
  .direction-heading .text-link{font-size:14px;min-height:44px}
  .direction-start>p{font-size:16px;line-height:1.9;color:var(--ink);margin-bottom:20px}
  .direction-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
  .direction-grid>a{display:block;padding:18px;background:var(--paper);transition:background-color .2s}
  .direction-grid>a:hover,.direction-grid>a:focus-visible{background:#e1e8d9}
  .direction-grid span{font-size:13px;color:var(--green);font-variant-numeric:tabular-nums}
  .direction-grid h3{font-family:var(--sans);font-size:19px;font-weight:500;margin:8px 0}
  .direction-grid p{font-size:16px;line-height:1.8;color:var(--muted);margin:0}
  @media(max-width:850px){.direction-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:480px){.direction-start{padding:20px}.direction-grid{grid-template-columns:1fr}.direction-heading h2{font-size:21px}}
</style>
