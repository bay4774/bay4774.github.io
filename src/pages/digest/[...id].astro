---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { withBase } from '../../lib/paths';
import '../../styles/digest.css';
export async function getStaticPaths() {
  const entries = await getCollection('digest', ({ data }) => !data.draft);
  return entries.map(entry => ({ params: { id: entry.id }, props: { entry } }));
}
interface Props { entry: CollectionEntry<'digest'>; }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { data } = entry;
const ratings = { 'must-read': 'Must-read · 必读基线', inspiring: 'Inspiring · 思路启发', engineering: 'Engineering · 工程典范' };
const digests = await getCollection('digest', ({ data }) => !data.draft);
const related = digests.filter(other => other.id !== entry.id && (data.related.includes(other.id) || other.data.tags.some(tag => data.tags.includes(tag)))).slice(0, 3);
const toc = headings.filter(heading => heading.depth === 2);
---
<Layout title={`${data.title} · Paper Digest`} description={data.description}>
  <article class="container digest-article">
    <a class="digest-back" href={withBase('/digest/')}><span aria-hidden="true">←</span> 返回论文精读</a>
    <header class="digest-article-header"><div class="digest-article-kicker"><p class="eyebrow">PAPER DIGEST / 阅读手记</p><span class={`digest-rating rating-${data.rating}`}>{ratings[data.rating]}</span></div><h1>{data.title}</h1><p class="digest-article-original" lang="en">{data.originalTitle}</p><div class="digest-article-tags">{data.tags.map(tag => <a class="pill" href={withBase(`/digest/?topic=${encodeURIComponent(tag)}`)}>#{tag}</a>)}</div><div class="digest-article-byline"><span>阅读于 {data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}</span><span>{data.readTime} min read</span><span>★ {data.stars} / 5</span></div></header>
    {data.demo && <aside class="digest-article-demo"><span class="demo-badge">示例文章</span><p>这是一篇用于展示排版与写作结构的演示手记。论文标题、作者、机构及分析均为待替换的示例，未声称对应真实研究。</p></aside>}
    <dl class="digest-metadata"><div class="digest-metadata-title"><dt>ORIGINAL TITLE / 原文标题</dt><dd>{data.originalTitle}</dd></div><div><dt>AUTHORS & LAB / 作者与机构</dt><dd>{data.authors}<span>{data.lab}</span></dd></div><div><dt>VENUE & YEAR / 来源</dt><dd>{data.venue} · {data.year}</dd></div><div><dt>MY RATING / 阅读价值</dt><dd>{ratings[data.rating]}<span aria-label={`${data.stars} 星评级`}>{'★'.repeat(data.stars)}{'☆'.repeat(5 - data.stars)}</span></dd></div><div class="digest-metadata-links"><dt>SOURCE / 原始资料</dt><dd>{data.originalUrl ? <a href={withBase(data.originalUrl)} target="_blank" rel="noopener noreferrer">原论文 <Icon name="arrow-up-right" size={15} /></a> : <span>原论文链接待填写</span>}{data.code ? <a href={withBase(data.code)} target="_blank" rel="noopener noreferrer">官方代码 <Icon name="arrow-up-right" size={15} /></a> : <span>代码链接待填写</span>}</dd></div></dl>
    <div class="digest-reading-layout"><aside class="digest-toc"><span class="digest-toc-label">ON THIS PAGE</span><nav aria-label="文章目录">{toc.map((heading, index) => <a href={`#${heading.slug}`}><span>{String(index + 1).padStart(2, '0')}</span>{heading.text}</a>)}</nav><div class="digest-reading-key"><span><i class="objective-dot"></i>原论文解读与评估</span><span><i class="insight-dot"></i>我的观点与灵感</span><p>区分已有证据与待验证的想法，是每篇手记的起点。</p></div></aside><div class="prose digest-prose"><Content /></div></div>
    {related.length > 0 && <section class="digest-related"><div class="section-head"><div><p class="eyebrow">KEEP READING</p><h2 class="section-title">相邻的研究问题</h2></div><a class="digest-all-link" href={withBase('/digest/')}>全部手记 <Icon name="arrow-right" size={18} /></a></div><div class="digest-related-grid">{related.map(other => <a href={withBase(`/digest/${other.id}/`)}><span>{other.data.venue} · {other.data.year}{other.data.demo && ' · 示例'}</span><h3>{other.data.title}</h3><p>{other.data.verdict}</p><span class="digest-related-arrow"><Icon name="arrow-up-right" size={20} /></span></a>)}</div></section>}
  </article>
</Layout>
