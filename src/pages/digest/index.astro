---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import DigestCard from '../../components/DigestCard.astro';
import KnowledgeGraph from '../../components/KnowledgeGraph.astro';
import Icon from '../../components/Icon.astro';
import { withBase } from '../../lib/paths';
import '../../styles/digest.css';
const entries = (await getCollection('digest', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || (b.data.citations?.count ?? 0) - (a.data.citations?.count ?? 0));
const publications = await getCollection('publications', ({ data }) => !data.draft);
const topics = [...new Set(entries.flatMap(entry => entry.data.tags))].sort();
const venues = [...new Set(entries.map(entry => entry.data.venue))].sort();
const weeks = [...new Set(entries.map(entry => entry.data.week))].sort().reverse();
const curatedCount = entries.filter(entry => entry.data.curated).length;
const citationDates = [...new Set(entries.flatMap(entry => entry.data.citations ? [entry.data.citations.accessed] : []))];
const citationSources = [...new Set(entries.flatMap(entry => entry.data.citations ? [entry.data.citations.source] : []))];
const ratingLabels = { 'must-read': 'Must-read · 必读基线', inspiring: 'Inspiring · 思路启发', engineering: 'Engineering · 工程典范' };
---
<Layout title="Paper Digest · 论文分享与精读" description="围绕具身智能、生成建模与物理动作，分享高影响力论文及结构化阅读导读。">
  <div class="container digest-page" data-digest-browser>
    <header class="page-intro digest-page-intro">
      <div><p class="eyebrow">INPUT & INSIGHT / 论文分享与精读</p><h1 class="page-heading">Reading beyond<br /><em>the abstract.</em></h1><p class="digest-intro-copy">围绕感知、生成、控制与物理动作，整理值得反复阅读的经典方法。把论文的贡献、适用边界与后续问题放在一起。</p></div>
      <div class="digest-intro-aside"><span class="digest-large-number">{String(entries.length).padStart(2, '0')}</span><span>SHARED PAPERS<br />从经典方法开始</span><div class="digest-intro-dot"></div><p>理解一个方法，<br />也理解它的适用边界。</p></div>
    </header>
    {entries.some(entry => entry.data.demo) && <p class="digest-demo-notice"><span class="demo-badge">演示内容</span> 下方条目用于展示阅读模板与交互，非真实论文精读记录。可在内容文件夹中替换。</p>}
    {curatedCount > 0 && <p class="digest-citation-audit"><strong>{curatedCount} 篇精选阅读导读</strong> · 根据研究方向与引用影响力筛选。{citationSources.length > 0 && `引用数据来自 ${citationSources.join(' / ')}，查阅于 ${citationDates.join(' / ')}；每篇详情提供原文与计量记录。`}后续可在此补充个人精读和实验笔记。</p>}
    <section class="digest-filter-console" aria-label="筛选论文精读">
      <div class="digest-console-top"><label class="digest-search"><Icon name="search" size={19} /><span class="sr-only">搜索论文标题、方法或研究观点</span><input type="search" name="q" placeholder="搜索标题、核心方法、研究观点…" autocomplete="off" data-digest-search /><kbd aria-hidden="true">/</kbd></label><div class="digest-view-switch" role="group" aria-label="阅读视图"><button type="button" data-digest-view="cards" aria-pressed="true">论文分享</button><button type="button" data-digest-view="weekly" aria-pressed="false">Weekly Roundup <span>合集</span></button></div></div>
      <div class="digest-topic-row"><span class="digest-filter-label">TOPICS</span><div class="digest-topic-buttons" role="group" aria-label="按研究专题筛选"><button type="button" class="digest-topic is-active" data-topic-filter="" aria-pressed="true">All topics</button>{topics.map(topic => <button type="button" class="digest-topic" data-topic-filter={topic} aria-pressed="false">#{topic}</button>)}</div></div>
      <div class="digest-select-row"><label><span>会议 / 来源</span><select data-digest-venue><option value="">全部来源</option>{venues.map(venue => <option value={venue}>{venue}</option>)}</select></label><label><span>阅读价值</span><select data-digest-rating><option value="">全部评级</option>{Object.entries(ratingLabels).map(([value, label]) => <option value={value}>{label}</option>)}</select></label><button type="button" class="digest-reset" data-digest-reset>清空筛选 <span aria-hidden="true">↺</span></button><p class="digest-result-count" role="status" aria-live="polite" aria-atomic="true" data-digest-count>{entries.length} 篇论文分享</p></div>
    </section>
    <section class="digest-grid" data-digest-cards aria-label="论文分享">{entries.map((entry, index) => <DigestCard entry={entry} index={index} />)}</section>
    <section class="digest-weekly" data-digest-weekly hidden aria-label="每周前沿阅读合集">{weeks.map(week => {
      const weeklyEntries = entries.filter(entry => entry.data.week === week);
      const weeklyTopics = [...new Set(weeklyEntries.flatMap(entry => entry.data.tags))];
      return <article class="digest-week" data-digest-week><header><div><span class="eyebrow">WEEKLY PAPER ROUNDUP</span><h2>{week.replace('W', 'Week ')}</h2><p>{weeklyTopics.slice(0, 3).join(' / ')}</p></div><span class="digest-week-count" data-week-count>{weeklyEntries.length} 篇论文</span></header><div class="digest-week-entries">{weeklyEntries.map((entry, index) => <a href={withBase(`/digest/${entry.id}/`)} data-week-entry={entry.id}><span class="digest-week-index">{String(index + 1).padStart(2, '0')}</span><div><div class="digest-week-meta">{entry.data.venue} {entry.data.year} · {entry.data.readTime} min read{entry.data.demo && <span class="demo-badge">示例</span>}</div><h3>{entry.data.title}</h3><p>{entry.data.verdict}</p></div><Icon name="arrow-up-right" size={20} /></a>)}</div></article>;
    })}</section>
    <div class="digest-empty" data-digest-empty hidden><span aria-hidden="true">↗</span><h2>还没有匹配的论文</h2><p>试试其他关键词，或放宽专题与来源筛选。</p><button type="button" class="button button-secondary" data-digest-reset>显示全部论文</button></div>
    <section class="digest-graph-section"><div class="section-head"><div><p class="eyebrow">CONNECT THE DOTS</p><h2 class="section-title">阅读如何生长为研究</h2></div><p class="muted">方法之间的联系，<br />是新问题的起点。</p></div><KnowledgeGraph digests={entries} publications={publications} /></section>
  </div>
</Layout>
<script>
  const browser = document.querySelector<HTMLElement>('[data-digest-browser]');
  if (browser) {
    const search = browser.querySelector<HTMLInputElement>('[data-digest-search]')!;
    const venue = browser.querySelector<HTMLSelectElement>('[data-digest-venue]')!;
    const rating = browser.querySelector<HTMLSelectElement>('[data-digest-rating]')!;
    const topicButtons = [...browser.querySelectorAll<HTMLButtonElement>('[data-topic-filter]')];
    const viewButtons = [...browser.querySelectorAll<HTMLButtonElement>('[data-digest-view]')];
    const cards = [...browser.querySelectorAll<HTMLElement>('[data-digest-card]')];
    const cardsContainer = browser.querySelector<HTMLElement>('[data-digest-cards]')!;
    const weeklyContainer = browser.querySelector<HTMLElement>('[data-digest-weekly]')!;
    const empty = browser.querySelector<HTMLElement>('[data-digest-empty]')!;
    const count = browser.querySelector<HTMLElement>('[data-digest-count]')!;
    let topic = '';
    let view = 'cards';
    const query = new URLSearchParams(window.location.search);
    search.value = query.get('q') || '';
    if ([...venue.options].some(option => option.value === query.get('venue'))) venue.value = query.get('venue') || '';
    if ([...rating.options].some(option => option.value === query.get('rating'))) rating.value = query.get('rating') || '';
    if (topicButtons.some(button => button.dataset.topicFilter === query.get('topic'))) topic = query.get('topic') || '';
    if (query.get('view') === 'weekly') view = 'weekly';
    function update() {
      const term = search.value.trim().toLowerCase();
      const visibleIds = new Set<string>();
      cards.forEach(card => {
        const tags = JSON.parse(card.dataset.topic || '[]') as string[];
        const matches = (!term || (card.dataset.search || '').includes(term)) && (!topic || tags.includes(topic)) && (!venue.value || card.dataset.venue === venue.value) && (!rating.value || card.dataset.rating === rating.value);
        card.hidden = !matches;
        if (matches && card.dataset.id) visibleIds.add(card.dataset.id);
      });
      topicButtons.forEach(button => { const active = button.dataset.topicFilter === topic; button.classList.toggle('is-active', active); button.setAttribute('aria-pressed', String(active)); });
      viewButtons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.digestView === view)));
      browser!.querySelectorAll<HTMLElement>('[data-digest-week]').forEach(week => {
        let visibleCount = 0;
        week.querySelectorAll<HTMLElement>('[data-week-entry]').forEach(entry => { const visible = visibleIds.has(entry.dataset.weekEntry || ''); entry.hidden = !visible; if (visible) visibleCount++; });
        week.hidden = visibleCount === 0;
        const weekCount = week.querySelector<HTMLElement>('[data-week-count]');
        if (weekCount) weekCount.textContent = `${visibleCount} 篇论文`;
      });
      cardsContainer.hidden = view !== 'cards' || visibleIds.size === 0;
      weeklyContainer.hidden = view !== 'weekly' || visibleIds.size === 0;
      empty.hidden = visibleIds.size !== 0;
      count.textContent = `${visibleIds.size} 篇论文分享${view === 'weekly' ? ' · 合集视图' : ''}`;
      const params = new URLSearchParams();
      if (search.value.trim()) params.set('q', search.value.trim());
      if (topic) params.set('topic', topic);
      if (venue.value) params.set('venue', venue.value);
      if (rating.value) params.set('rating', rating.value);
      if (view !== 'cards') params.set('view', view);
      history.replaceState(null, '', `${window.location.pathname}${params.size ? '?' + params.toString() : ''}${window.location.hash}`);
    }
    search.addEventListener('input', update);
    venue.addEventListener('change', update);
    rating.addEventListener('change', update);
    topicButtons.forEach(button => button.addEventListener('click', () => { topic = button.dataset.topicFilter || ''; update(); }));
    viewButtons.forEach(button => button.addEventListener('click', () => { view = button.dataset.digestView || 'cards'; update(); }));
    browser.querySelectorAll<HTMLButtonElement>('[data-digest-reset]').forEach(button => button.addEventListener('click', () => { search.value = ''; venue.value = ''; rating.value = ''; topic = ''; update(); }));
    document.addEventListener('keydown', event => { if (event.key === '/' && !(event.target instanceof HTMLElement && event.target.closest('input, textarea, select, [contenteditable]'))) { event.preventDefault(); search.focus(); } });
    update();
  }
</script>
