---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import CurriculumNav from '../../components/CurriculumNav.astro';
import DirectionNav from '../../components/DirectionNav.astro';
import { withBase } from '../../lib/paths';
import '../../styles/notes-browser.css';
export async function getStaticPaths() { return (await getCollection('notes',({data})=>!data.draft)).map(entry=>({params:{id:entry.id},props:{entry}})); }
interface Props { entry: CollectionEntry<'notes'>; }
const { entry }=Astro.props;const { Content, headings }=await render(entry);const p=entry.data;
const categoryNames={theory:'理论推导',tutorial:'技术教程',lecture:'课程讲义',teaching:'教学讲义'};
const toc = headings.filter(heading => heading.depth === 2);
---
<Layout title={p.title} description={p.description}>
  <header class="article-header"><div class="container"><nav class="breadcrumb" aria-label="面包屑"><a href={withBase('/')}>Home</a><span>/</span><a href={withBase('/notes/')}>Lectures & Notes</a><span>/</span><span>{p.title}</span></nav><h1>{p.title}</h1><p>{p.description}</p><div class="article-meta"><span>{categoryNames[p.category]}</span><span><Icon name="clock" size={13} />阅读约 {p.readTime} 分钟</span><span>{p.chapters} {p.category === 'teaching' ? '专题' : (p.foundationOrder !== undefined || p.directionTrack || entry.id === 'direction-foundations') ? '小节' : '章'}</span><span>{p.date.toISOString().slice(0,10)}</span>{p.demo && <span class="demo-badge">示例讲义</span>}</div><div class="tag-row">{p.tags.map(t=><span class="pill">{t}</span>)}</div>{(p.pdf||p.slides) && <div style="display:flex;gap:10px;margin:24px 0">{p.pdf&&<a class="button button-secondary" href={withBase(p.pdf)} target="_blank" rel="noopener noreferrer"><Icon name="download" size={15} />Download PDF</a>}{p.slides&&<a class="button button-secondary" href={withBase(p.slides)} target="_blank" rel="noopener noreferrer"><Icon name="external" size={15} />Lecture slides</a>}</div>}{p.demo&&<div class="demo-notice" style="margin-top:25px"><span class="demo-badge">示例</span><span>用于预览推导与排版。公式和伪代码是结构说明，完整讲义与课程材料待补充。</span></div>}</div></header>
  <CurriculumNav foundationChapter={p.foundationChapter} reviewStatus={p.reviewStatus} />
  <DirectionNav directionTrack={p.directionTrack} directionChapter={p.directionChapter} />
  {p.html && <div class="container" style="margin-top:24px"><a class="button button-primary" href={withBase(p.html)} target="_blank" rel="noopener noreferrer"><Icon name="book" size={16} />阅读完整 HTML 讲义 <Icon name="arrow-up-right" size={15} /></a></div>}
  {toc.length > 0 && <div class="container"><details class="mobile-reading-toc"><summary>本页目录 <span>{toc.length} 节</span></summary><nav aria-label="本页章节目录">{toc.map(heading => <a href={`#${heading.slug}`}>{heading.text}</a>)}</nav></details></div>}
  <div class="container article-body"><article class="prose"><Content /><div class="article-end"><a class="text-link" href={withBase('/notes/')}><Icon name="arrow-left" size={15} />返回讲义目录</a><a class="text-link" href={withBase('/projects/')}>工程项目 <Icon name="arrow-up-right" size={15} /></a></div></article><aside class="article-sidebar"><div class="sidebar-sticky"><h2>CONTENTS / 目录</h2>{headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}<div class="sidebar-box"><h2>CONTINUE EXPLORING</h2><a href={withBase('/digest/')}>前沿论文精读 ↗</a><a href={withBase('/projects/')}>工程实现与工具 ↗</a></div></div></aside></div>
</Layout>
